# Django
SECRET_KEY=tu-secret-key-super-larga
DEBUG=False
ALLOWED_HOSTS=tudominio.up.railway.app
CSRF_TRUSTED_ORIGINS=https://tudominio.up.railway.app

# Base de datos (Railway la inyecta como DATABASE_URL)
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Cloudinary
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# Email (Gmail con contraseña de aplicación)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=tu@gmail.com
EMAIL_HOST_PASSWORD=tu_app_password
DEFAULT_FROM_EMAIL=ArmyLock <tu@gmail.com>